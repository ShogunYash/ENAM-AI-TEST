# Copy to .env (git-ignored) and fill in. All three have free tiers; the router skips providers with no key.
# Gemini:     https://aistudio.google.com/apikey   (primary)
# Groq:       https://console.groq.com/keys        (short-input fallback)
# OpenRouter: https://openrouter.ai/keys           (emergency fallback, :free models only)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides
# FINN_DATA_DIR=backend/data
# FINN_LLM_CONFIG=backend/config/models.yaml
